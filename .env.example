# AutoAgent Negotiation Playground — environment template.
# Copy to .env.local and fill in. Never commit .env.local.

# ─── LLM provider selection ──────────────────────────────────────────────
# "anthropic" (default, production) | "gemini" (dev-only, free tier)
LLM_PROVIDER=anthropic

# ─── Anthropic (production) ──────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic. Paid — Sonnet 4.6.
ANTHROPIC_API_KEY=
# Optional: pin a specific Claude snapshot. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Gemini (dev/testing escape hatch) ───────────────────────────────────
# Required when LLM_PROVIDER=gemini. Free tier at aistudio.google.com/apikey.
# Use this for local manual testing of the chat without burning Anthropic credits.
GEMINI_API_KEY=
# Optional: override model. Defaults to gemini-2.5-flash (free tier friendly).
# GEMINI_MODEL=gemini-2.5-flash

# ─── Kill switch ─────────────────────────────────────────────────────────
# Set to "false" to disable the negotiation endpoint (returns 503). Any other
# value (or unset) keeps it enabled.
# NEGOTIATION_ENABLED=true

# --- Apify (on-demand WebMotors scraping) ---
# Required by /api/scrape/webmotors. Personal API token from:
#   https://console.apify.com/account/integrations
# Token string begins with apify_api_. Also set in Vercel Production+Preview env.
APIFY_API_TOKEN=your_apify_token_here
